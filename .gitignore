# Local environments, credentials and editor/test state.
__pycache__/
*.pyc
.venv/
.DS_Store
.idea/
.env
.env.*
!.env.template
!.env.example
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.sqlite3
*.sqlite3-*
*.sqlite3.lock
*.parquet
*.pickle
*.pkl

# Data release allowlist: retain the dataset, its splits and annotation inputs.
# Other JSONL/CSV records stay on disk but are not selected by Git.
*.jsonl
*.csv
!/data_preparation/vital_persons/metadata/cohort.jsonl
!/data_preparation/vital_persons/metadata/gold_initial.jsonl
!/data_preparation/vital_persons/metadata/gold_normalized.jsonl
!/data_preparation/vital_persons/metadata/gold_adapted.jsonl
!/data_preparation/vital_persons/metadata/development.jsonl
!/data_preparation/vital_persons/metadata/test.jsonl
!/data_preparation/vital_persons/samples/**/*.jsonl
!/data_preparation/vital_persons/datasets/*/train.jsonl
!/data_preparation/vital_persons/datasets/*/dev.jsonl
!/data_preparation/vital_persons/datasets/*/test.jsonl
!/data_preparation/vital_persons/datasets/*/case_targets.jsonl
!/parsing/**/human_validation/**/*.jsonl
!/parsing/**/human_validation/**/*.csv
!/parsing/location/**/training/train.jsonl
!/parsing/location/**/training/dev.jsonl
!/parsing/location/**/preparation/annotations.jsonl
!/parsing/location/rewriter/preparation/population.jsonl
!/parsing/location/normalization/tests/fixtures/*.jsonl
!/evaluation/vital_persons/corrections.jsonl
!/evaluation/vital_persons/answer_status/human_validation/**/*.jsonl
!/evaluation/vital_persons/answer_status/human_validation/**/*.csv
!/human_annotations/generalization/*.jsonl

# Generated processing traces, caches and all full evaluation runs are local-only.
/data_preparation/vital_persons/cache/
/data_preparation/vital_persons/datasets/*/consensus.json
/data_preparation/vital_persons/datasets/*/rewrite_provenance.json
/data_preparation/granola/recognition/
/evaluation/vital_persons/results*/
/evaluation/vital_persons/figures/
/evaluation/vital_persons/answer_status/batch/
/generalization/generations/
/generalization/results/
/generalization/figures/
/generalization/correctness-judge/cache/
/generalization/correctness-judge/results/
/generalization/granularity-judge/batch/
/generalization/granularity-judge/cache/
/generalization/granularity-judge/results/
/generalization/human-study/data/
/generalization/human-study/annotations/
/generalization/human-study/results/
/generalization/human-study/label_studio/*.json
/ablations/**/results/
/ablations/lfm/short/results.csv
/ablations/lfm/**/dev/
/ablations/lfm/**/vital_persons/
/ablations/lfm/**/generalization/
/ablations/lfm/greedy-control/preparation/
/ablations/lfm/greedy-control/*/data/
/training/results/
/parsing/location/**/human_validation/predictions.*
!/parsing/location/extractor/human_validation/predictions.json
!/parsing/location/filter/human_validation/predictions.json
!/parsing/location/rewriter/human_validation/predictions.json
/parsing/location/**/training/*predictions.json

# Locally generated training and evaluation runs.
/runs/

# Fitted granularity-metric parameters used by evaluation.
!/generalization/human-study/results/
/generalization/human-study/results/**
!/generalization/human-study/results/metric.json

# Answer-status run logs and duplicate text reports are not released.
/evaluation/vital_persons/answer_status/results/*/summary.json
/evaluation/vital_persons/answer_status/results/*/validation/summary.txt
